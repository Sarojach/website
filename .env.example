# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///saroj_portfolio.db
# For PostgreSQL: postgresql://username:password@localhost:5432/dbname
# For MySQL: mysql://username:password@localhost:3306/dbname

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ADMIN_API_KEY=your-admin-api-key-here-change-in-production

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com

# Email Configuration (Optional - for sending contact form emails)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
# MAIL_NOTIFY_TO=acharyasaroj9800@gmail.com  # Email that will receive notifications

# Application Settings
APP_TITLE=Saroj Acharya Portfolio
CONTACT_RATE_LIMIT=10  # Max contacts per hour per IP
